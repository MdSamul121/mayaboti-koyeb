# Free & Monthly-Credit LLM Provider Keys (set at least one)
GROQ_API_KEY=gsk_your_groq_api_key                  # Free tier
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key # Free tier (50 free req/day per key)
GEMINI_API_KEY=your_gemini_api_key                  # Free tier (e.g. gemini-3.1-flash-lite)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key            # Free developer tier
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key     # Recurring monthly free inference credits

# Default provider & model (e.g. groq + qwen/qwen3.8-27b, gemini + gemini-3.1-flash-lite, or openrouter/free)
MAYABOTI_PROVIDER=groq
MAYABOTI_MODEL=qwen/qwen3.8-27b

# Telegram Channel (IMPORTANT: Use a NEW token from @BotFather, NOT @Ariferex_bot)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric User IDs allowed to command this agent
TELEGRAM_ALLOW_FROM=123456789

# WebUI Security Token (set your own secret password/token for persistent logins)
MAYABOTI_WEB_TOKEN=change-this-to-a-strong-secret

# Runtime / Server Port (Koyeb sets PORT automatically; BotKeep may use SERVER_PORT or PORT)
PORT=8080
RESTRICT_TO_WORKSPACE=true
